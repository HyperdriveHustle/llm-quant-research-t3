{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HyperdriveHustle/llm-quant-research-t3/schemas/agent_action.schema.json",
  "title": "Agentic Quant Research Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "action",
    "reason",
    "arguments"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action": {
      "enum": ["propose", "evaluate", "refine", "pivot", "stop"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "hypothesis_id": {"type": ["string", "null"]},
    "expected_observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "decision_rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "arguments": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "propose"}}},
      "then": {
        "required": ["expected_observation", "decision_rule"],
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hypothesis", "candidates"],
            "properties": {
              "hypothesis": {"$ref": "#/$defs/hypothesis"},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {"$ref": "#/$defs/candidate"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "evaluate"}}},
      "then": {
        "required": ["hypothesis_id", "expected_observation", "decision_rule"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor_ids", "window_alias"],
            "properties": {
              "factor_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "window_alias": {
                "enum": ["search_full", "search_early", "search_late"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "refine"}}},
      "then": {
        "required": ["hypothesis_id", "expected_observation", "decision_rule"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent_factor_id", "edit_type", "candidates"],
            "properties": {
              "parent_factor_id": {"type": "string"},
              "edit_type": {
                "enum": [
                  "parameter",
                  "structural",
                  "normalization",
                  "interaction",
                  "ablation"
                ]
              },
              "change_summary": {"type": "string", "maxLength": 2000},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {"$ref": "#/$defs/candidate"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "pivot"}}},
      "then": {
        "required": ["expected_observation", "decision_rule"],
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_hypothesis_id",
              "closure_status",
              "closure_reason",
              "new_hypothesis",
              "candidates"
            ],
            "properties": {
              "from_hypothesis_id": {"type": "string"},
              "closure_status": {
                "enum": ["rejected", "suspended", "inconclusive"]
              },
              "closure_reason": {"type": "string", "maxLength": 3000},
              "new_hypothesis": {"$ref": "#/$defs/hypothesis"},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {"$ref": "#/$defs/candidate"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "stop"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "factor_ids", "evidence_ids", "limitations"],
            "properties": {
              "mode": {"enum": ["submit", "no_discovery"]},
              "factor_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "evidence_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "limitations": {
                "type": "array",
                "items": {"type": "string"}
              },
              "conclusion": {"type": "string", "maxLength": 5000}
            },
            "allOf": [
              {
                "if": {"properties": {"mode": {"const": "submit"}}},
                "then": {
                  "properties": {
                    "factor_ids": {"minItems": 1},
                    "evidence_ids": {"minItems": 1}
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression", "direction"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "expression": {"type": "string", "minLength": 1, "maxLength": 8000},
        "direction": {"enum": [-1, 1]},
        "rationale": {"type": "string", "maxLength": 2000}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "mechanism",
        "predicted_direction",
        "falsification_rule"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "mechanism": {"type": "string", "minLength": 1, "maxLength": 4000},
        "predicted_direction": {"enum": [-1, 1]},
        "falsification_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    }
  }
}
